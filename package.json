{
  "name": "@geovation/gb-name-index",
  "version": "0.1.0",
  "description": "Tiny client for the Great Britain name prefix index.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./browser": "./dist/index.global.js"
  },
  "files": [
    "dist",
    "ATTRIBUTION.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "export:catalyst-docs": "node scripts/export-catalyst-docs.mjs",
    "test": "node --test",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "dev": "vite web --config web/vite.config.js --host 127.0.0.1",
    "check-pages-size": "node scripts/check-pages-size.mjs build/data"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@lucide/svelte": "^1.43.0",
    "@picocss/pico": "^2.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "esbuild": "^0.28.2",
    "svelte": "^5.57.0",
    "vite": "^8.2.2"
  }
}
